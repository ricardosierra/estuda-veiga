# Arquivos binários e originais acadêmicos: manter localmente, fora do Git.
*.docx
*.pdf
*.pages
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.zip
*.7z
*.key

# Originais completos dos trabalhos: preservar localmente, fora do Git.
/originais/

# Binários ficam fora do Git. Diagramas viram Mermaid (.md); ícone do app é exceção.
!/app/src-tauri/icons/icon.png

# Arquivos do sistema e configurações locais.
.DS_Store
.env
.env.*
!.env.example

# Aplicativo Tauri Estuda UVA: dependências e artefatos de compilação.
/.estuda-uva.sqlite3
/.estuda-uva.sqlite3-wal
/.estuda-uva.sqlite3-shm
/.estuda-uva.sqlite3-journal
# Backups gerados quando um banco antigo é regenerado (nunca vão ao Git).
*.bak.sqlite3
*.bak.sqlite3-wal
*.bak.sqlite3-shm
*.bak.sqlite3-journal
/app/node_modules/
/app/dist/
/app/src-tauri/target/
/app/target/
/app/src-tauri/gen/schemas/
/app/src-tauri/.estuda-uva-data/
/app/src-tauri/chromium-profile/
/app/src-tauri/*.app
/app/src-tauri/*.dmg

# Capturas autenticadas do boletim podem conter notas, frequência e identificadores.
/materias/catalogo/capturas/

# Área temporária local do Estuda UVA.
/.estuda-uva/sync-tmp/
/.estuda-uva/mirrors/
**/.estuda-sync-*.tmp

# Gerado por tools/acervo a partir de dados/ (não versionar; ver dados/LEIA-ME.md).
/build/
/materias/catalogo/curriculos/
/materias/catalogo/disciplinas.json
/materias/catalogo/relacoes.json
/materias/catalogo/trajetorias.json

# Crates de domínio (docs/arquitetura/02): artefatos de compilação.
/crates/*/target/
