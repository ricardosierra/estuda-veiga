{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Estuda UVA",
  "version": "0.1.0",
  "identifier": "br.edu.uva.estuda",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Estuda UVA",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Education",
    "shortDescription": "Acervo e estudo local para cursos UVA"
  }
}
