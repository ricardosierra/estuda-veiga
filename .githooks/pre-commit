#!/bin/sh
# Hook pre-commit versionado: remove a mensagem de copyright dos textos extraídos
# que estão em staging. Ver .githooks/README.md.
raiz=$(git rev-parse --show-toplevel) || exit 1
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: Node.js não encontrado; a limpeza de copyright não rodou. Instale o Node 24 ou use --no-verify conscientemente." >&2
  exit 1
fi
exec node "$raiz/.githooks/strip-copyright.mjs" --staged
